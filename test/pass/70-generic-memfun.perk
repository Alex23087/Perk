import "stdio.h"

type <T> List = Nil | Cons(T, List @ T)

fun <T> List.forall (self: List @ T, pred: (T) => bool): bool {
    match (self) {
        Nil {
            return true
        },
        Cons (var hd, var tl) {
            if (pred(hd)) {
                return tl.forall(pred)
            } else {
                return false
            }
        }
    }
}

type_fun <T> List.make_empty(): List @ T {
    return Nil @ T
}

type_fun <T> List.num(ber: int): int {
    return ber
}

fun main() : void {
    printf("%s", if
        List@int.make_empty().forall(
            (a: int): bool {
                return false
            }
        ) then "success" else "failure"
    );

    printf("%d\n", List@int.num(42))
    let l : List@int = Nil
    List_make_empty@int()
}